<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/md_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_tagline"
                android:textSize="14sp"
                android:alpha="0.6"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 番茄畅听 Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="16dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/target_fanqie_listen"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="com.xs.fm"
                    android:textSize="12sp"
                    android:alpha="0.4"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_listen_vip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/feat_vip" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_listen_ad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/feat_ad_block" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 番茄小说 Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="16dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/target_fanqie_novel"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="com.dragon.read"
                    android:textSize="12sp"
                    android:alpha="0.4"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_novel_tab"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/feat_tab_clean" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_novel_float"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/feat_float_clean" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 红果短剧 Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="16dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/target_hongguo"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="com.phoenix.read"
                    android:textSize="12sp"
                    android:alpha="0.4"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_hongguo_tab"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/feat_tab_clean" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_hongguo_float"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/feat_float_clean" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Status hint -->
        <com.google.android.material.materialswitch.MaterialTextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_hint"
            android:textSize="12sp"
            android:alpha="0.5"
            android:gravity="center"
            android:padding="12dp" />

    </LinearLayout>
</ScrollView>
